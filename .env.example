NODE_ENV=development
# Use 2factor for real SMS delivery, console for local testing, or disabled to block OTP.
OTP_DELIVERY=console
TWO_FACTOR_API_KEY=
ADMIN_PHONE=9596523404
PORT=4000
CLIENT_ORIGIN=*
MONGODB_URI=mongodb://127.0.0.1:27017/aura-shopping
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Flat delivery fee in INR; 0 means free delivery.
DELIVERY_CHARGE=0

# Required for store registration: 64 hex characters (32 random bytes).
# Keep private and backed up; changing this key requires migrating encrypted records.
STORE_ENCRYPTION_KEY=
